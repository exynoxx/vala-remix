	g_type_class_adjust_private_offset (klass, &FundamentalPriv_private_offset);
}

static void
fundamental_priv_instance_init (FundamentalPriv * self,
                                gpointer klass)
{
	self->priv = fundamental_priv_get_instance_private (self);
	self->priv->secret = 7;
}

static void
fundamental_priv_finalize (Fundamental * obj)
{
	FundamentalPriv * self;
	self = G_TYPE_CHECK_INSTANCE_CAST (obj, TYPE_FUNDAMENTAL_PRIV, FundamentalPriv);
	FUNDAMENTAL_CLASS (fundamental_priv_parent_class)->finalize (obj);
}

