	GType fundamental_priv_type_id;
	fundamental_priv_type_id = g_type_register_static (TYPE_FUNDAMENTAL, "FundamentalPriv", &g_define_type_info, 0);
	FundamentalPriv_private_offset = g_type_add_instance_private (fundamental_priv_type_id, sizeof (FundamentalPrivPrivate));
	return fundamental_priv_type_id;
}

GType
fundamental_priv_get_type (void)
{
	static volatile gsize fundamental_priv_type_id__once = 0;
	if (g_once_init_enter (&fundamental_priv_type_id__once)) {
		GType fundamental_priv_type_id;
		fundamental_priv_type_id = fundamental_priv_get_type_once ();
		g_once_init_leave (&fundamental_priv_type_id__once, fundamental_priv_type_id);
	}
	return fundamental_priv_type_id__once;
}

