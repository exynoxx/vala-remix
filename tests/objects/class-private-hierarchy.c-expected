}

FundamentalPriv*
fundamental_priv_new (void)
{
	return fundamental_priv_construct (TYPE_FUNDAMENTAL_PRIV);
}

static void
fundamental_priv_class_init (FundamentalPrivClass * klass,
                             gpointer klass_data)
{
